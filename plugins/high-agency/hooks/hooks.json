{
  "description":"High Agency Git-baseline tracking, targeted verification guard, conditional final diff review, and bounded continuation.",
  "hooks":{
    "UserPromptSubmit":[{"hooks":[{"type":"command","command":"python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/verification_state.py\"","timeout":2}]}],
    "PostToolUse":[{"matcher":"Bash|Edit|Write|NotebookEdit","hooks":[{"type":"command","command":"python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/verification_state.py\"","timeout":2}]}],
    "Stop":[{"hooks":[{"type":"command","command":"python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_loop.py\"","timeout":3}]}]
  }
}
